# URL base do grupo de APIs de negócio (HARLEY) do Xano, sem barra final.
XANO_API_BASE_URL=https://seu-workspace.xano.io/api:seu-grupo
# URL base do grupo "Authentication" (login e auth/me). Cada grupo do Xano tem
# a própria URL (/api:<canonical>); se omitida, usa XANO_API_BASE_URL.
XANO_AUTH_API_BASE_URL=https://seu-workspace.xano.io/api:grupo-auth
# false em desenvolvimento local; true quando a aplicação usa HTTPS.
XANO_AUTH_COOKIE_SECURE=false

# --- Testes de integração (tests/test_integration_xano.py) ---
# Sem XANO_API_BASE_URL real, a suíte de integração é ignorada.
# Use um branch/workspace de testes: entradas de mercadoria são imutáveis.
# XANO_TEST_GERENTE_EMAIL=
# XANO_TEST_GERENTE_PASSWORD=
# XANO_TEST_VENDEDOR_EMAIL=
# XANO_TEST_VENDEDOR_PASSWORD=
# XANO_TEST_MECANICO_EMAIL=
# XANO_TEST_MECANICO_PASSWORD=
# true habilita cenários que gravam dados (entrada de mercadoria, rollback, ciclo de OS,
# itens com baixa e devolução de estoque).
# XANO_TEST_ALLOW_WRITES=false
# true (junto com ALLOW_WRITES) roda as corridas de estoque e de cancelamento; exige duas motos livres.
# XANO_TEST_CONCURRENCY=false